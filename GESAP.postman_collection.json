		{
			"name": "05. gesap-api — Emergencies",
			"item": [
				{
					"name": "Crear emergencia (ASISTENTE_PREHOSPITALARIO)",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Authorization", "value": "Bearer {{token}}"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"patientId\": 1,\n  \"hospitalDestinationId\": 1,\n  \"primaryAssessment\": {\n    \"airway\": \"permeable\",\n    \"breathing\": \"normal\",\n    \"circulation\": \"pulso_presente\",\n    \"disability\": \"consciente\",\n    \"exposure\": \"sin_lesiones_visibles\"\n  },\n  \"secondaryAssessment\": {\n    \"symptoms\": \"dolor_toracico\",\n    \"allergies\": \"penicilina\",\n    \"medications\": \"losartan\",\n    \"history\": \"HTA\",\n    \"events\": \"inicio_subito\"\n  },\n  \"notes\": \"Paciente refiere dolor toracico intenso de 30 minutos de evolución\",\n  \"transferDate\": \"2024-06-15T14:30:00.000Z\"\n}"
						},
						"url": "{{api_url}}/emergencies"
					}
				},
				{
					"name": "Listar emergencias (AUDITOR)",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{api_url}}/emergencies"
					}
				},
				{
					"name": "Listar emergencias — filtrar por status",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {
							"raw": "{{api_url}}/emergencies?status=PENDING",
							"host": ["{{api_url}}"],
							"path": ["emergencies"],
							"query": [{"key": "status", "value": "PENDING"}]
						}
					}
				},
				{
					"name": "Emergencias pendientes del hospital (ASISTENTE_RECEPCION_CLINICA)",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{api_url}}/emergencies/pending/1"
					}
				},
				{
					"name": "Obtener emergencia por ID",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{api_url}}/emergencies/1"
					}
				},
				{
					"name": "Actualizar emergencia (solo PENDING)",
					"request": {
						"method": "PATCH",
						"header": [
							{"key": "Authorization", "value": "Bearer {{token}}"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"notes\": \"Paciente estabilizado, presion arterial controlada\",\n  \"primaryAssessment\": {\n    \"airway\": \"permeable\",\n    \"breathing\": \"dificultad_leve\"\n  }\n}"
						},
						"url": "{{api_url}}/emergencies/1"
					}
				},
				{
					"name": "Asignar emergencia (ASISTENTE_RECEPCION_CLINICA)",
					"request": {
						"method": "PATCH",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{api_url}}/emergencies/1/assign"
					}
				},
				{
					"name": "Completar emergencia (ASISTENTE_RECEPCION_CLINICA)",
					"request": {
						"method": "PATCH",
						"header": [
							{"key": "Authorization", "value": "Bearer {{token}}"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
