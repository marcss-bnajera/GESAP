{
	"info": {
		"_postman_id": "gesap-complete-collection",
		"name": "GESAP — Sistema Completo",
		"description": "Colección completa del Sistema de Gestión de Atención a Pacientes (MSPAS Guatemala).\n\nServicios:\n- gesap-api (puerto 3000): Core\n- gesap-auditor (puerto 3001): Panel de administración\n- gesap-patient-portal (puerto 3002): Portal de pacientes\n\nSwagger UI:\n- http://localhost:3000/gesap/v1/docs\n- http://localhost:3001/gesap-auditor/v1/docs\n- http://localhost:3002/gesap-portal/v1/docs\n\nUsuarios de prueba:\n- superauditor@gesap.gt / GESAP2024!\n- auditor@gesap.gt / GESAP2024!\n- dr.lopez@gesap.gt / Doctor2024!\n\nFlujo recomendado:\n1. Login (gesap-api) → guardar token en variable\n2. Crear paciente\n3. Crear emergencia\n4. Asignar y completar emergencia",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "api_url",
			"value": "http://localhost:3000/gesap/v1",
			"type": "string"
		},
		{
			"key": "auditor_url",
			"value": "http://localhost:3001/gesap-auditor/v1",
			"type": "string"
		},
		{
			"key": "portal_url",
			"value": "http://localhost:3002/gesap-portal/v1",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "auditor_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "portal_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "01. gesap-api — Auth",
			"item": [
				{
					"name": "Login como SUPER_AUDITOR",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.access_token) {",
									"    pm.collectionVariables.set('token', json.access_token);",
									"    pm.collectionVariables.set('auditor_token', json.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"superauditor@gesap.gt\",\n  \"password\": \"GESAP2024!\"\n}"
						},
						"url": "{{api_url}}/auth/login"
					}
				},
				{
					"name": "Login como AUDITOR (HSJD)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.access_token) {",
									"    pm.collectionVariables.set('token', json.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"auditor@gesap.gt\",\n  \"password\": \"GESAP2024!\"\n}"
						},
						"url": "{{api_url}}/auth/login"
					}
				},
				{
					"name": "Login como DOCTOR",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.access_token) {",
									"    pm.collectionVariables.set('token', json.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"dr.lopez@gesap.gt\",\n  \"password\": \"Doctor2024!\"\n}"
						},
						"url": "{{api_url}}/auth/login"
					}
				},
				{
					"name": "Ver perfil autenticado",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{api_url}}/auth/profile"
					}
				}
			]
		},
