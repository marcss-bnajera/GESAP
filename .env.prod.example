# GESAP — Variables de entorno para producción
# Copia este archivo: cp .env.prod.example .env.prod
# Completa los valores reales y NUNCA subas .env.prod al repositorio

# ── Base de datos ────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CambiaEstePorUnaContrasenaSegura2026!
POSTGRES_DB=gesap_db

# ── JWT (usa un valor largo y aleatorio, no el de desarrollo) ────────────────
# Generar: openssl rand -hex 64
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_SEGURO_GENERADO_CON_OPENSSL

# ── Puertos internos (no cambiar salvo conflicto) ────────────────────────────
PORT_API=3000
PORT_AUDITOR=3001
PORT_PATIENT=3002
